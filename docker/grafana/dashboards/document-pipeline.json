{
  "uid": "mvp-document-pipeline",
  "title": "Document Pipeline",
  "tags": [
    "mvp",
    "documents"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "w": 24,
        "h": 3,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Domanda:** i documenti caricati arrivano in fondo alla pipeline, e quando si fermano, dove?\n\nL'imbuto misura la dispersione fra un passo e il successivo. Alert correlati: `DocumentStuckInProcessing`, `StepFunctionExecutionFailed`, `QueueBacklogHigh` — Runbook: docs/runbooks/document-pipeline.md"
      }
    },
    {
      "type": "row",
      "title": "Dove si fermano",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "bargauge",
      "title": "Imbuto della pipeline documentale",
      "gridPos": {
        "w": 16,
        "h": 9,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_sub_documents)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "1 · Rilevati",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(mvp_sub_documents_review{review_status=~\"auto_validated|manually_validated|needs_review|quarantined\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "2 · Con esito di revisione",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(mvp_sub_documents_review{review_status=~\"auto_validated|manually_validated\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "3 · Validati",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum(mvp_sub_documents_send{send_status=\"sent\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "4 · Scaricati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ogni barra è un passo della pipeline, in ordine. La differenza fra due barre consecutive è la dispersione di quel passo. Le barre partono da zero e sono proporzionali: è ciò che rende leggibile un imbuto."
    },
    {
      "type": "stat",
      "title": "Oltre timeout",
      "gridPos": {
        "w": 8,
        "h": 4,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_documents_stuck_processing)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "bloccati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti in elaborazione oltre MVP_PROCESSING_TIMEOUT_SECONDS. Su questo scatta DocumentStuckInProcessing."
    },
    {
      "type": "stat",
      "title": "Falliti",
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"failed\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti la cui elaborazione si è interrotta. Restano caricati: l'errore è di estrazione, non di ingestione."
    },
    {
      "type": "row",
      "title": "Stato corrente",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "stat",
      "title": "Completati",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"completed\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "completati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "In elaborazione",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"processing\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in corso",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "In attesa",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"pending\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in attesa",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Caricati ma non ancora presi in carico dalla pipeline."
    },
    {
      "type": "stat",
      "title": "Da verificare",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_sub_documents_review{review_status=\"needs_review\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "da verificare",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sotto-documenti sotto la soglia di confidenza (MVP_CONFIDENCE_THRESHOLD): richiedono una revisione manuale."
    },
    {
      "type": "row",
      "title": "Flusso e cause",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput step pipeline (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_received_total{task_type!~\"communication.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}} ricevuti"
        },
        {
          "refId": "B",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_failed_total{task_type!~\"communication.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}} falliti"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Solo i task documentali: il filtro esclude quelli della pipeline comunicazioni, che hanno una dashboard propria."
    },
    {
      "type": "table",
      "title": "Fallimenti Step Functions per motivo",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (mvp_stepfunctions_executions_failed_total{state_machine=~\".*document-pipeline\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "fallimenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "Motivo",
              "Value": "Fallimenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "`start_failure` è un avvio rifiutato da Step Functions; `task_failure` è un task che si è interrotto durante l'esecuzione."
    },
    {
      "type": "table",
      "title": "Sotto-documenti per stato di invio",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (send_status) (mvp_sub_documents_send)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "sotto-documenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "send_status": "Stato",
              "Value": "Sotto-documenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "`sent` significa che il PDF è stato scaricato: il recapito avviene fuori piattaforma, quindi il download è l'ultimo evento osservabile."
    },
    {
      "type": "table",
      "title": "Esiti di revisione",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (review_status) (mvp_sub_documents_review)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "sotto-documenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "review_status": "Esito",
              "Value": "Sotto-documenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Partizione completa dei sotto-documenti: la somma delle righe è il totale rilevato."
    },
    {
      "type": "row",
      "title": "Log",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "logs",
      "title": "Errori pipeline (worker documenti + app)",
      "gridPos": {
        "w": 24,
        "h": 11,
        "x": 0,
        "y": 40
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"mvp\", service=~\"queue|app\"} |~ \"(?i)level_name.{0,6}(error|critical|emergency)\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Monolog scrive JSON con level_name; i container di infrastruttura usano logfmt con level=. Il filtro copre entrambi."
    }
  ]
}
