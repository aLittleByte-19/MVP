// Grafana Alloy — collects logs from this compose project's containers and ships
// them to Loki. Alloy is the supported successor of Promtail (EOL 2026-03).

logging {
  level  = "warn"
  format = "logfmt"
}

// Discover only containers belonging to the "mvp" compose project.
discovery.docker "mvp" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=mvp"]
  }
}

// Map Docker metadata to useful Loki labels (service, container, project).
discovery.relabel "mvp" {
  targets = discovery.docker.mvp.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "mvp" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.mvp.output
  forward_to       = [loki.write.default.receiver]
  refresh_interval = "10s"
}

// Il livello non viene promosso a label qui, per non introdurre cardinalita'
// alta: le dashboard filtrano gli errori con una regex sulla riga
// (`|~ "(?i)level_name.{0,6}(error|critical|emergency)"`), che copre sia i log
// JSON di Monolog sia il logfmt dei container di infrastruttura.

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
